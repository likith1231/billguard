# Anthropic API key. Without it, AI audits are off; the sample case and free manual mode still work.
ANTHROPIC_API_KEY=

# Optional: claude-sonnet-5-5 (default), claude-opus-5-5 (most thorough) or claude-haiku-5-5 (cheapest)
CLAUDE_MODEL=

# Accounts (required in production; the AI audit and AI letters need a signed-in user).
# Postgres connection string, e.g. Neon's pooled one. Tables are created on first use.
DATABASE_URL=
# Random string, 32+ characters: openssl rand -hex 32
AUTH_SECRET=

# Optional daily AI limits (UTC day). Defaults: 10 audits and 30 letters per account; 200 / 600 across all accounts.
AI_AUDIT_DAILY_LIMIT=
AI_LETTER_DAILY_LIMIT=
AI_AUDIT_GLOBAL_DAILY_LIMIT=
AI_LETTER_GLOBAL_DAILY_LIMIT=
